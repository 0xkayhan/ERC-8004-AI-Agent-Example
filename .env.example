# Copy this file to `.env` and fill in the values you need.
# `.env` is git-ignored, so it is safe to store secrets there.

# ── Local development ────────────────────────────────────────────────────────
# Only needed if your local node does not listen on the default port.
# LOCALHOST_RPC_URL=http://127.0.0.1:8545

# ── Sepolia testnet ──────────────────────────────────────────────────────────
# An RPC endpoint (Alchemy, Infura, publicnode, ...).
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key

# Private key of the deployer account, WITHOUT the 0x prefix is also accepted,
# but 0x-prefixed is recommended. NEVER commit a key that holds real funds.
# PRIVATE_KEY=0xabc123...

# ── Optional deploy-script behaviour ─────────────────────────────────────────
# Set to "true" to also register a demo agent right after deploying.
# REGISTER_DEMO_AGENT=false
